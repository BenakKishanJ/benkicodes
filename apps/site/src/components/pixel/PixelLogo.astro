---
// BK badge: border uses the accent colour, letters use currentColor.
import { LOGO, spriteRects } from '../../lib/sprites';
interface Props { size?: number; class?: string }
const { size = 2, class: cls = '' } = Astro.props;
const w = LOGO[0].length, h = LOGO.length;
const border = LOGO.map((r, y) => [...r].map((c, x) => (c === '#' && (y === 0 || y === h - 1 || x === 0 || x === w - 1) ? '#' : '.')).join(''));
const letters = LOGO.map((r, y) => [...r].map((c, x) => (c === '#' && !(y === 0 || y === h - 1 || x === 0 || x === w - 1) ? '#' : '.')).join(''));
---
<svg class={cls} width={w * size} height={h * size} viewBox={`0 0 ${w} ${h}`} shape-rendering="crispEdges" role="img" aria-label="BK logo">
  <g fill="var(--accent)" set:html={spriteRects(border)} />
  <g fill="currentColor" set:html={spriteRects(letters)} />
</svg>
