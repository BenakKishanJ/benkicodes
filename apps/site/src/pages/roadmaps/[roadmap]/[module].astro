---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PixelEdge from '../../../components/pixel/PixelEdge.astro';
import PixelIcon from '../../../components/pixel/PixelIcon.astro';
import SectionHeader from '../../../components/pixel/SectionHeader.astro';
import TOC from '../../../components/content/TOC.astro';
import Quiz from '../../../components/learning/Quiz';
import AdSlot from '../../../components/ads/AdSlot.astro';
import { getModules, getRoadmaps, roadmapSlug, moduleSlug } from '../../../lib/content';
import { formatDate, isoDate } from '../../../lib/utils';

export const getStaticPaths = (async () => {
  const [modules, roadmaps] = await Promise.all([getModules(), getRoadmaps()]);
  return modules.map((mod) => {
    const rs = roadmapSlug(mod.id);
    const siblings = modules.filter((m) => roadmapSlug(m.id) === rs);
    const i = siblings.findIndex((m) => m.id === mod.id);
    return {
      params: { roadmap: rs, module: moduleSlug(mod.id) },
      props: {
        mod,
        roadmapTitle: roadmaps.find((r) => roadmapSlug(r.id) === rs)?.data.title ?? rs,
        prev: siblings[i - 1] ?? null,
        next: siblings[i + 1] ?? null,
        position: `${i + 1} of ${siblings.length}`,
      },
    };
  });
}) satisfies GetStaticPaths;

const { mod, roadmapTitle, prev, next, position } = Astro.props;
const rs = roadmapSlug(mod.id);
const { data } = mod;
const { Content, headings } = await render(mod);
const typeLabel: Record<string, string> = { docs: 'docs', video: 'video', article: 'article', repo: 'repo', book: 'book' };
---
<BaseLayout title={`${data.title} · ${roadmapTitle}`} description={`${data.title}: module ${position} of the ${roadmapTitle} roadmap. ${data.objectives[0]}`} type="article">
  <section class="sec sec-first sec-pad-b tone-a grid-bg" data-title="module">
    <div class="wrap relative z-10 grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <nav aria-label="Breadcrumb" class="meta mb-10 flex flex-wrap gap-2" data-reveal>
          <a href="/roadmaps/" class="hover:text-accent">roadmaps</a><span>/</span><a href={`/roadmaps/${rs}/`} class="hover:text-accent">{roadmapTitle}</a>
        </nav>
        <p class="meta mb-6" data-reveal>module {position} · ~{data.estimatedMinutes} min · reviewed <time datetime={isoDate(data.lastReviewed)}>{formatDate(data.lastReviewed)}</time></p>
        <h1 class="px-font text-[clamp(1.5rem,4vw,3rem)] leading-[1.35]" data-reveal>{data.title}</h1>
      </div>
      <section class="px p-7 sm:p-9 lg:col-span-5" style="--sh:var(--accent);--o:10px" aria-labelledby="obj-h" data-reveal>
        <h2 id="obj-h" class="t-3 mb-6">learning objectives</h2>
        <ul class="space-y-4 text-[13px]">{data.objectives.map((o) => <li class="flex gap-3"><PixelIcon name="check" size={2} class="mt-1 shrink-0 text-accent" />{o}</li>)}</ul>
      </section>
    </div>
    <PixelEdge to="b" seed={31} />
  </section>

  <section class="sec sec-pad-b tone-b grid-bg" data-title="lesson">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <aside class="lg:col-span-3"><div class="lg:sticky lg:top-28"><TOC headings={headings} /></div></aside>
      <div class="lg:col-span-8 lg:col-start-5">
        <div class="prose"><Content /></div>
        <AdSlot slot="in-article" />
        {data.resources.length > 0 && (
          <section class="px mt-20 p-6 sm:p-8" aria-labelledby="res-h">
            <h2 id="res-h" class="t-3 mb-6">further reading</h2>
            <ul class="space-y-4 text-[13px]">
              {data.resources.map((r) => (
                <li class="flex flex-wrap items-baseline gap-3"><span class="tag tag-plain">{typeLabel[r.type]}</span><a class="underline decoration-dashed underline-offset-4 hover:text-accent" href={r.url} rel="noopener noreferrer" target="_blank">{r.title}</a></li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
    <PixelEdge to="a" seed={32} />
  </section>

  <section class="sec tone-a grid-bg" data-title="quiz" style="padding-bottom:clamp(4rem,10vh,7rem)">
    <div class="wrap">
      <div class="mx-auto max-w-3xl">
        <h2 class="t-2 mb-12" data-reveal>Check yourself</h2>
        <Quiz client:visible quizId={`${rs}/${moduleSlug(mod.id)}`} questions={data.quiz} />
        <nav class="mt-20 grid gap-8 sm:grid-cols-2" aria-label="Module navigation">
          {prev ? (
            <a class="px px-hover block p-6" href={`/roadmaps/${rs}/${moduleSlug(prev.id)}/`}>
              <span class="meta flex items-center gap-2"><PixelIcon name="arrow-left" size={2} /> previous</span>
              <span class="t-3 mt-3 block">{prev.data.title}</span>
            </a>
          ) : <span />}
          {next ? (
            <a class="px px-hover px-accent block p-6 sm:text-right" href={`/roadmaps/${rs}/${moduleSlug(next.id)}/`}>
              <span class="meta flex items-center gap-2 sm:justify-end">next <PixelIcon name="arrow-right" size={2} /></span>
              <span class="t-3 mt-3 block">{next.data.title}</span>
            </a>
          ) : (
            <a class="px px-hover px-accent block p-6 sm:text-right" href={`/roadmaps/${rs}/`}>
              <span class="meta">finished</span><span class="t-3 mt-3 block">back to the roadmap</span>
            </a>
          )}
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>
