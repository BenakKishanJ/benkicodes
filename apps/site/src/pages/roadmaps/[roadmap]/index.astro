---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PixelEdge from '../../../components/pixel/PixelEdge.astro';
import PixelIcon from '../../../components/pixel/PixelIcon.astro';
import Pips from '../../../components/pixel/Pips.astro';
import SectionHeader from '../../../components/pixel/SectionHeader.astro';
import RoadmapProgress from '../../../components/learning/RoadmapProgress';
import { getRoadmaps, getModules, roadmapSlug, moduleSlug } from '../../../lib/content';
import { formatDate, isoDate } from '../../../lib/utils';
import { siteConfig } from '../../../site.config';

export const getStaticPaths = (async () => {
  const roadmaps = await getRoadmaps();
  return roadmaps.map((entry) => ({ params: { roadmap: roadmapSlug(entry.id) }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const slug = roadmapSlug(entry.id);
const { data } = entry;
const { Content } = await render(entry);
const modules = await getModules(slug);

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Course',
    name: data.title, description: data.description,
    provider: { '@type': 'Person', name: siteConfig.author.name },
    dateModified: data.lastReviewed.toISOString(),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: 'Roadmaps', item: `${siteConfig.url}/roadmaps/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${siteConfig.url}/roadmaps/${slug}/` },
    ],
  },
];
---
<BaseLayout title={`${data.title} roadmap`} description={data.description} jsonLd={jsonLd} snap="mandatory">
  <section class="sec sec-full sec-first sec-pad-b tone-a grid-bg" data-title="overview">
    <span class="bgword" style="right:-3%;bottom:14%" data-parallax-x="0.1" aria-hidden="true">PATH</span>
    <div class="wrap relative z-10 grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <nav aria-label="Breadcrumb" class="meta mb-10 flex gap-2" data-reveal><a href="/roadmaps/" class="hover:text-accent">roadmaps</a><span>/</span><span class="text-fg">{slug}</span></nav>
        <h1 class="t-1" data-reveal>{data.title}</h1>
        <p class="lead mt-10" data-reveal>{data.description}</p>
        {modules.length > 0 && (
          <p class="mt-12" data-reveal><a class="btn btn-primary" href={`/roadmaps/${slug}/${moduleSlug(modules[0].id)}/`}>start module 1 <PixelIcon name="arrow-right" size={2} /></a></p>
        )}
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <div class="px p-7" style="--sh:var(--accent);--o:10px" data-reveal>
          <p class="px-font mb-4 text-[10px] text-muted">spec sheet</p>
          <dl class="spec">
            <div><dt>level</dt><dd><Pips level={data.level} /></dd></div>
            <div><dt>time</dt><dd>~{data.estimatedHours}h</dd></div>
            <div><dt>modules</dt><dd>{modules.length}</dd></div>
            <div><dt>version</dt><dd>v{data.version}</dd></div>
            <div><dt>reviewed</dt><dd><time datetime={isoDate(data.lastReviewed)}>{formatDate(data.lastReviewed)}</time></dd></div>
          </dl>
        </div>
      </div>
    </div>
    <PixelEdge to="b" seed={21} />
  </section>

  <section class="sec sec-pad-b tone-b grid-bg" data-title="outcomes">
    <div class="wrap">
      <div class="grid gap-16 md:grid-cols-2">
        <div>
          <SectionHeader title="You will be able to" />
          <ul class="mt-10 space-y-5">{data.outcomes.map((o) => <li class="flex gap-4" data-reveal><PixelIcon name="check" size={2} class="mt-1.5 shrink-0 text-accent" />{o}</li>)}</ul>
        </div>
        {data.prerequisites.length > 0 && (
          <div>
            <SectionHeader title="Before you start" />
            <ul class="mt-10 space-y-5">{data.prerequisites.map((o) => <li class="flex gap-4" data-reveal><PixelIcon name="plus" size={2} class="mt-1.5 shrink-0 text-accent2" />{o}</li>)}</ul>
          </div>
        )}
      </div>
      <div class="prose mt-20"><Content /></div>
    </div>
    <PixelEdge to="a" seed={22} />
  </section>

  <section class="sec sec-full tone-a grid-bg" data-title="modules">
    <div class="wrap grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeader title="Module path" meta={`${modules.length} modules`} />
        <p class="lead mt-10">Pass each quiz to light up its node. Progress is stored on this device only.</p>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        {modules.length ? (
          <RoadmapProgress client:load roadmap={slug}
            modules={modules.map((m) => ({ slug: moduleSlug(m.id), title: m.data.title, order: m.data.order, minutes: m.data.estimatedMinutes }))} />
        ) : <p class="px p-6 text-muted">Modules are on the way.</p>}
      </div>
    </div>
  </section>
</BaseLayout>
