---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixelCover from '../../components/pixel/PixelCover.astro';
import PixelEdge from '../../components/pixel/PixelEdge.astro';
import TOC from '../../components/content/TOC.astro';
import SourcesList from '../../components/content/SourcesList.astro';
import SectionHeader from '../../components/pixel/SectionHeader.astro';
import PixelIcon from '../../components/pixel/PixelIcon.astro';
import PostCard from '../../components/content/PostCard.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { siteConfig } from '../../site.config';
import { getPosts } from '../../lib/content';
import { formatDate, isoDate, readingTime } from '../../lib/utils';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

const all = await getPosts();
const related = all
  .filter((p) => p.id !== post.id && p.data.tags.some((t) => data.tags.includes(t)))
  .slice(0, 2);

const url = new URL(`/blog/${post.id}/`, siteConfig.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting',
    headline: data.title, description: data.description, mainEntityOfPage: url,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.lastReviewed).toISOString(),
    author: { '@type': 'Person', name: siteConfig.author.name, url: `${siteConfig.url}/about/` },
    image: data.cover ? new URL(data.cover.src, siteConfig.url).href : undefined,
    keywords: data.tags.join(', '),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteConfig.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
---
<BaseLayout title={data.title} description={data.description} type="article" image={data.cover?.src}
  publishedTime={data.pubDate} modifiedTime={data.updatedDate ?? data.lastReviewed} canonical={data.canonical} jsonLd={jsonLd}>
  <section class="sec sec-first sec-pad-b tone-a grid-bg" data-title="intro">
    <div class="wrap relative z-10 grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <nav aria-label="Breadcrumb" class="meta mb-10 flex gap-2" data-reveal>
          <a href="/" class="hover:text-accent">home</a><span>/</span><a href="/blog/" class="hover:text-accent">blog</a><span>/</span><span class="text-fg">{data.category}</span>
        </nav>
        <h1 class="px-font text-[clamp(1.25rem,3.2vw,2.25rem)] leading-[1.45]" data-reveal>{data.title}</h1>
        <p class="lead mt-10" data-reveal>{data.description}</p>
        <p class="mt-8 flex flex-wrap gap-2" data-reveal>{data.tags.map((t) => <a class="tag" href={`/blog/tags/${t}/`}>{t}</a>)}</p>
      </div>
      <div class="space-y-10 lg:col-span-5">
        <div class="px p-3" style="--sh:var(--accent2);--o:10px">
          <PixelCover seed={post.id} src={data.cover?.src} alt={data.cover?.alt} />
        </div>
        <dl class="spec" data-reveal>
          <div><dt>author</dt><dd>{siteConfig.author.name}</dd></div>
          <div><dt>published</dt><dd><time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time></dd></div>
          <div><dt>reviewed</dt><dd><time datetime={isoDate(data.lastReviewed)}>{formatDate(data.lastReviewed)}</time></dd></div>
          <div><dt>reading time</dt><dd>{readingTime(post.body)} min</dd></div>
        </dl>
      </div>
    </div>
    <PixelEdge to="b" seed={11} />
  </section>

  <section class="sec sec-pad-b tone-b grid-bg" data-title="article">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <aside class="lg:col-span-3 min-w-0"><div class="lg:sticky lg:top-28 min-w-0"><TOC headings={headings} /></div></aside>
      <article class="lg:col-span-8 lg:col-start-5 min-w-0">
        <div class="prose"><Content /></div>
        <AdSlot slot="in-article" />
        <div class="mt-20 space-y-8">
          <SourcesList sources={data.sources} />
          {data.aiAssisted && (
            <p class="meta max-w-[68ch]">{siteConfig.aiDisclosure} <a class="underline decoration-dashed underline-offset-4" href="/editorial-policy/">How this site is made</a>. Spotted a mistake? <a class="underline decoration-dashed underline-offset-4" href={`mailto:${siteConfig.author.email}?subject=${encodeURIComponent('Correction: ' + data.title)}`}>Report an error</a>.</p>
          )}
        </div>
      </article>
    </div>
    <PixelEdge to="a" seed={12} />
  </section>

  <section class="sec tone-a grid-bg" data-title="next" style="padding-bottom:clamp(4rem,10vh,7rem)">
    <div class="wrap">
      <SectionHeader title={related.length ? 'Keep reading' : 'More'} meta="related by tag" />
      {related.length > 0 && <div class="mt-16 grid gap-10 md:grid-cols-2">{related.map((p) => <PostCard post={p} />)}</div>}
      <p class="mt-16"><a class="btn" href="/blog/"><PixelIcon name="arrow-left" size={2} /> all posts</a></p>
    </div>
  </section>
</BaseLayout>
