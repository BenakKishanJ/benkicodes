---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/pixel/TerminalWindow.astro';
import PixelLogo from '../components/pixel/PixelLogo.astro';
import PixelIcon from '../components/pixel/PixelIcon.astro';
import PixelEdge from '../components/pixel/PixelEdge.astro';
import SectionHeader from '../components/pixel/SectionHeader.astro';
import { siteConfig } from '../site.config';

// Edit these rows. They render like neofetch output.
const rows: [string, string][] = [
  ['name', siteConfig.author.name],
  ['role', 'final-year CS student → full-stack AI engineer'],
  ['stack', 'Kotlin/Compose, React/Next.js, Node/NestJS, Python, PostgreSQL'],
  ['ai', 'LangGraph, RAG, Gemini API'],
  ['editor', 'neovim / vscode'],
  ['os', 'Arch Linux, btw'],
];
const links = [
  { icon: 'branch', label: 'github', href: siteConfig.author.github, rel: 'me noopener' },
  { icon: 'user', label: 'linkedin', href: siteConfig.author.linkedin, rel: 'me noopener' },
  { icon: 'mail', label: 'email', href: `mailto:${siteConfig.author.email}`, rel: '' },
  { icon: 'terminal', label: 'rss', href: '/rss.xml', rel: '' },
];
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: siteConfig.author.name,
  url: `${siteConfig.url}/about/`, sameAs: [siteConfig.author.github, siteConfig.author.linkedin],
};
---
<BaseLayout title="About" description={`About ${siteConfig.author.name}: who writes this site, how, and why.`} jsonLd={person} snap="mandatory">
  <section class="sec sec-full sec-first sec-pad-b tone-a grid-bg" data-title="whoami">
    <span class="bgword" style="left:-2%;bottom:10%" data-parallax-x="-0.1" aria-hidden="true">ABOUT</span>
    <div class="wrap relative z-10 grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <TerminalWindow title="benki@codes — neofetch" bodyClass="p-7 text-[13px]" class="[--sh:var(--accent)] [--o:10px]">
          <div class="flex flex-col items-start gap-8 sm:flex-row">
            <span class="bob text-fg"><PixelLogo size={6} /></span>
            <dl class="space-y-2">
              {rows.map(([k, v]) => (<div class="flex gap-3"><dt class="w-14 shrink-0 text-accent">{k}</dt><dd>{v}</dd></div>))}
            </dl>
          </div>
          <p class="mt-8 flex gap-1" aria-hidden="true">{['red', 'orange', 'yellow', 'green', 'aqua', 'blue', 'violet', 'pink'].map((c) => <i class="block h-4 w-6" style={`background:var(--${c})`}></i>)}</p>
        </TerminalWindow>
      </div>
      <div class="lg:col-span-7 lg:pl-10">
        <h1 class="t-1" data-reveal>About</h1>
        <p class="lead mt-10" data-reveal>Hi, I'm {siteConfig.author.name}. I build full-stack products and AI agents, and I write down what I learn so the next person has a shorter path.</p>
        <p class="prompt mt-10 text-[13px]" data-reveal>whoami<span class="caret" aria-hidden="true"></span></p>
      </div>
    </div>
    <PixelEdge to="b" seed={51} />
  </section>

  <section class="sec sec-full sec-pad-b tone-b grid-bg" data-title="why">
    <div class="wrap grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeader title="Why this site exists" />
        <p class="t-2 mt-14 max-w-[20ch]" data-reveal>Specifics beat adjectives.</p>
      </div>
      <div class="prose lg:col-span-6 lg:col-start-7">
        <p>Most learning content is either too generic to help or too dated to trust. Here, every roadmap has a last-reviewed date, every article lists its sources, and every quiz exists to check that the lesson actually landed.</p>
        <h2>How the content is made</h2>
        <p>Articles are drafted with an AI pipeline I built, from sources I choose, then reviewed and edited by me before anything is published. The full process is on the <a href="/editorial-policy/">editorial policy</a> page.</p>
        <h2>My path here</h2>
        <p>I'm a final-year CS student writing code almost every day: Kotlin with Compose on the mobile side, React and Next.js on the web, Node and Python on the backend. Somewhere along the way AI stopped being a curiosity and became the most interesting engineering problem I'd found — so I started building with it properly: agents, retrieval pipelines, the unglamorous plumbing that makes models useful.</p>
        <p>This site is that learning made public. Every roadmap is something I've worked through or am working through, published only once I can defend it against a quiz. If a page is worth your time, it should survive your skepticism; when it doesn't, <a href="/contact/">the contact page</a> is right there.</p>
      </div>
    </div>
    <PixelEdge to="a" seed={52} />
  </section>

  <section class="sec tone-a grid-bg" data-title="find me" style="padding-bottom:clamp(4rem,10vh,7rem)">
    <div class="wrap">
      <SectionHeader title="Find me" meta="four ways" />
      <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {links.map((l) => (
          <a href={l.href} rel={l.rel || undefined} class="px px-hover flex flex-col gap-8 p-7" data-reveal>
            <span class="text-accent"><PixelIcon name={l.icon} size={4} /></span>
            <span class="t-3">{l.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
