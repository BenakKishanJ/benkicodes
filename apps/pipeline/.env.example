# --- Auth for the local API (the admin page sends this as X-Admin-Token). `pipeline serve` creates one if missing.
ADMIN_TOKEN=

# --- LLM (Gemini by default). Model names change fast: check https://ai.google.dev/gemini-api/docs/models
LLM_PROVIDER=google_genai
GOOGLE_API_KEY=
MODEL_FAST=gemini-3.1-flash-lite
MODEL_STRONG=gemini-3.5-flash
MODEL_CRITIC=gemini-3.5-flash
# ANTHROPIC_API_KEY=   (then: pip install -e ".[anthropic]", LLM_PROVIDER=anthropic, set the MODEL_* names)
# OPENAI_API_KEY=      (then: pip install -e ".[openai]",    LLM_PROVIDER=openai,    set the MODEL_* names)

# --- Where approved posts are written and committed (monorepo paths)
SITE_REPO_PATH=..
SITE_BLOG_DIR=apps/site/src/content/blog
SITE_BASE_URL=https://benkicodes.pages.dev
PUBLISH_MODE=git            # git = commit + push to GIT_BRANCH on approve | files = only write the file
GIT_BRANCH=main
GIT_REMOTE=origin

# --- Behaviour
CHECKPOINT_OUTLINE=true     # pause for outline approval before writing
MAX_AUTO_REVISIONS=2
MAX_SIMILARITY=0.18         # max share of 8-word runs copied from any single source
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
