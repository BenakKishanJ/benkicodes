# --- Auth for the local API (the admin page sends this as X-Admin-Token). `pipeline serve` creates one if missing.
ADMIN_TOKEN=

# --- OpenRouter (all four pipeline tasks go through it; model routing lives in config/models.yaml)
OPENROUTER_API_KEY=

# --- Where approved posts are pushed (monorepo paths; the worktree lives under data/)
SITE_REPO_PATH=../..        # repo root, relative to apps/pipeline
SITE_BLOG_DIR=apps/site/src/content/blog
SITE_BASE_URL=https://benkicodes.pages.dev
PUBLISH_MODE=git            # git = commit + push to GIT_BRANCH on approve | files = only a diff, no commit
GIT_BRANCH=main
GIT_REMOTE=origin

# --- Behaviour
BLOG_BUDGET_USD=1.0         # per-run cost cap; a run over the cap pauses and can be resumed from the admin page
CHECKPOINT_PLAN=true        # pause for plan approval before writing
MAX_AUTO_REVISIONS=1
MAX_SIMILARITY=0.18         # max share of 8-word runs copied from any single source
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
